# Copy to config/dm_tacclaw.env after verifying the two physical grippers.
# The defaults below come from vendor examples and must be confirmed on the bench.

DM_VENDOR_ROOT=./vendor/dm_tacclaw
DM_PYTHON=.venv-dm-tacclaw/bin/python

DM_LEFT_NAME=dm_tacclaw_left
DM_RIGHT_NAME=dm_tacclaw_right

# TODO: verify both devices. Vendor examples use 192.168.127.10.
DM_LEFT_HOST=192.168.127.10
DM_RIGHT_HOST=192.168.127.11

DM_GRIPPER_GRPC_PORT=55551
DM_FISH_CAMERA_GRPC_PORT=50088
DM_TACTILE_LEFT_GRPC_PORT=50051
DM_TACTILE_RIGHT_GRPC_PORT=50052

# Conservative first motion parameters. Range is 10..100.
DM_DEFAULT_SPEED=30
DM_DEFAULT_TORQUE=30

# Gripper position range: 0 closed, 1000 open.
DM_POS_CLOSED=0
DM_POS_HALF_OPEN=500
DM_POS_OPEN=1000

# Online teleop remains blocked until safety gate acceptance.
DM_ONLINE_CONTROL_ALLOWED=0
